            <h2>Este é o preço de lançamento.</h2>
            <div id="countdown">
                <div class="countdown-item"><div class="countdown-number" id="days">00</div><div class="countdown-label">Dias</div></div>
                <div class="countdown-item"><div class="countdown-number" id="hours">00</div><div class="countdown-label">Horas</div></div>
                <div class="countdown-item"><div class="countdown-number" id="minutes">00</div><div class="countdown-label">Minutos</div></div>
                <div class="countdown-item"><div class="countdown-number" id="seconds">00</div><div class="countdown-label">Segundos</div></div>
            </div>
            <div class="price-comparison">
                <span style="font-size: 1.4rem; opacity: 0.6; text-decoration: line-through;">R$ 1.997</span>
                <span style="font-size: 3rem; color: var(--primary); font-weight: 800; margin-left: 20px;">R$ 1.497</span>
            </div>

    <footer style="background: #050505; padding: 50px 0; text-align: center; opacity: 0.6;">
        <div class="container">
            <p>© 2026 Product Maker. Todos os direitos reservados.</p>
        </div>
    </footer>

    <script>
        // FAQ Toggle
        document.querySelectorAll('.faq-question').forEach(q => {
            q.addEventListener('click', () => {
                const item = q.parentElement;
                item.classList.toggle('active');
                q.querySelector('span').textContent = item.classList.contains('active') ? '▲' : '▼';
            });
        });

        // Countdown Timer
        const targetDate = new Date("June 15, 2026 23:59:00 GMT-0300").getTime();
        const timer = setInterval(function() {
            const now = new Date().getTime();
            const distance = targetDate - now;
            if (distance < 0) {
                clearInterval(timer);
                return;
            }
            document.getElementById("days").innerText = Math.floor(distance / (1000 * 60 * 60 * 24)).toString().padStart(2, '0');
            document.getElementById("hours").innerText = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)).toString().padStart(2, '0');
            document.getElementById("minutes").innerText = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)).toString().padStart(2, '0');
            document.getElementById("seconds").innerText = Math.floor((distance % (1000 * 60)) / 1000).toString().padStart(2, '0');
        }, 1000);

        // ActiveCampaign Integration
        document.getElementById('leadForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = this.querySelector('button');
            const msg = document.getElementById('formMessage');
            btn.disabled = true;
            btn.innerText = 'Enviando...';

            const formData = new FormData(this);
            const data = {
                contact: {
                    email: formData.get('email'),
                    firstName: formData.get('name'),
                    fieldValues: [{ field: '2', value: formData.get('whatsapp') }]
                }
            };

            try {
                const response = await fetch('https://diasallana1990.api-us1.com/api/3/contacts', {
                    method: 'POST',
                    headers: {
                        'Api-Token': '1ec2116b66b6cafe2b2a51cf8a32375654ec85cc3cef90a15f1cd566435b3e13604373fe',
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const contactData = await response.json();
                    const contactId = contactData.contact.id;

                    await fetch('https://diasallana1990.api-us1.com/api/3/contactLists', {
                        method: 'POST',
                        headers: { 'Api-Token': '1ec2116b66b6cafe2b2a51cf8a32375654ec85cc3cef90a15f1cd566435b3e13604373fe', 'Content-Type': 'application/json' },
                        body: JSON.stringify({ contactList: { list: 4, contact: contactId, status: 1 } })
                    });

                    const tags = [1, 2, 3];
                    for (const tagId of tags) {
                        await fetch('https://diasallana1990.api-us1.com/api/3/contactTags', {
                            method: 'POST',
                            headers: { 'Api-Token': '1ec2116b66b6cafe2b2a51cf8a32375654ec85cc3cef90a15f1cd566435b3e13604373fe', 'Content-Type': 'application/json' },
                            body: JSON.stringify({ contactTag: { contact: contactId, tag: tagId } })
                        });
                    }
                    
                    msg.innerText = 'Recebido! Verifique seu email em breve.';
                    msg.style.color = 'var(--primary)';
                    msg.style.display = 'block';
                    this.reset();
                    if (typeof gtag === 'function') gtag('event', 'form_submit');
                } else {
                    throw new Error('Erro na submissão');
                }
            } catch (error) {
                msg.innerText = 'Ocorreu um erro. Tente novamente.';
                msg.style.color = 'var(--secondary)';
                msg.style.display = 'block';
            } finally {
                btn.disabled = false;
                btn.innerText = 'QUERO SER UM AGENTIC PM →';
            }
        });

        function trackCtaClick(label) {
            if (typeof gtag === 'function') gtag('event', 'cta_click', { 'event_label': label });
        }

        let scroll50 = false, scroll90 = false;
        window.addEventListener('scroll', function() {
            const h = document.documentElement, b = document.body, st = 'scrollTop', sh = 'scrollHeight';
            const percent = (h[st]||b[st]) / ((h[sh]||b[sh]) - h.clientHeight) * 100;
            if (percent >= 50 && !scroll50) {
                if (typeof gtag === 'function') gtag('event', 'scroll_50');
                scroll50 = true;
            }
            if (percent >= 90 && !scroll90) {
                if (typeof gtag === 'function') gtag('event', 'scroll_90');
                scroll90 = true;
            }
        });
    </script>
</body>
</html>
